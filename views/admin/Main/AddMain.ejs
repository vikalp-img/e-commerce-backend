<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>
</head>
<body>
    <div>
        <div>
            <h1 class="text-2xl font-bold">Add Main Category</h1>
            <form action="/api/admin/add-main" method="POST" class="mt-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Main Category Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter Main Category Name" required class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500">
                </div>
                <button type="submit" class="mt-4 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Add Main Category</button>
                <a href="/api/admin/all" class="ml-2 bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Add Category</title>
  <!-- Tailwind CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<% 
  const array= ['New In','Bags','Jeans','Clothing','Athleisure','Lingerie','Shoes','Accessories',
  'Mid-Season Sale','End-Season Sale','Season-Start Sale','Season Sale','Innerwear','Girl','Boy','Our Brands'] 
%>

<body class="bg-gray-100 text-gray-900">
  <div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded shadow">
    <h1 class="text-2xl font-bold mb-6">Add Category</h1>

    <form action="/api/admin/add-category" method="POST" class="space-y-4">
      <div>
        <label for="categoryName" class="block mb-1 font-medium">Category Name</label>
        <input type="text" id="categoryName" name="categoryName" placeholder="Enter Category Name" required
          class="w-full border px-3 py-2 rounded focus:outline-none focus:ring focus:border-blue-300">
      </div>

      <div>
        <label for="gender" class="block mb-1 font-medium">Gender</label>
        <select id="gender" name="gender" required
          class="w-full border px-3 py-2 rounded focus:outline-none focus:ring focus:border-blue-300">
          <option value="male">Male</option>
          <option value="female">Female</option>
          <option value="kids">Kids</option>
          <option value="none">none</option>
        </select>
      </div>

      <div>
        <span class="block mb-2 font-medium">Sub Categories</span>
        <div class="flex flex-wrap gap-3">
          <% array.forEach(function(item) { %>
            <label class="flex items-center space-x-2">
              <input type="checkbox" id="<%= item %>" name="subCategory" value="<%= item %>" 
                class="rounded border-gray-300">
              <span class="text-gray-700"><%= item %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="flex space-x-3">
        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
          Add Category
        </button>
        <a href="/api/admin/all" class="bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400">
          Cancel
        </a>
      </div>
    </form>
  </div>
</body>
</html>
